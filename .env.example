# Telegram bot token — crie um bot no BotFather (https://t.me/BotFather) e cole o token aqui
TELEGRAM_BOT_TOKEN=

# RPC da Arbitrum — use um provedor com free tier (Alchemy ou Infura), não RPC público
ARBITRUM_RPC_URL=

# RPC da Base — opcional. Só ative o rastreamento de posições na Base
# preenchendo esta variável (deixe em branco pra manter só Arbitrum).
BASE_RPC_URL=

# RPC da Optimism — opcional. Só ative o rastreamento de posições na
# Optimism preenchendo esta variável.
OPTIMISM_RPC_URL=

# RPC da Polygon — opcional. Só ative o rastreamento de posições na
# Polygon preenchendo esta variável. Atenção: gas na Polygon é pago em
# POL, não ETH — ver comentário em src/config/chains.ts sobre a limitação
# no cálculo de custo de gas em token1 pra essa chain.
POLYGON_RPC_URL=

# Postgres local (via docker-compose.yml)
DATABASE_URL=postgres://poolsbot:poolsbot@localhost:5433/poolsbot

# Redis local (via docker-compose.yml) — usado para cache de respostas externas
REDIS_URL=redis://localhost:6379
