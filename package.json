{
  "name": "poolsbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/domain",
    "test:ci": "vitest run test/config test/domain test/data test/bot test/integration",
    "test:integration": "vitest run test/integration",
    "test:onchain": "vitest run test/onchain",
    "test:all": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "db:migrate:test": "DATABASE_URL=postgres://poolsbot:poolsbot@localhost:5433/poolsbot_test tsx src/persistence/migrate.ts",
    "pm2:start": "npm run build && pm2 start dist/main.js --name poolsbot",
    "pm2:restart": "npm run build && pm2 restart poolsbot",
    "pm2:stop": "pm2 stop poolsbot",
    "pm2:logs": "pm2 logs poolsbot"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "grammy": "^1.30.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "viem": "^2.21.51"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.28.1",
    "pm2": "^5.4.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
